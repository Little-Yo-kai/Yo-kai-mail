SECRET_KEY=change-me-for-local-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional; SQLite is used when DATABASE_URL is omitted.
# DATABASE_URL=postgresql://yokai:password@localhost:5432/yokai
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIRECRAWL_API_KEY=fc-your-key-here
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REFERENCE_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_MODEL=gemini-3.8-flash

MJML_NODE_BINARY=node
# Optional absolute path to an installed Chrome/Chromium executable.
EMAIL_SCREENSHOT_EXECUTABLE_PATH=
MJML_COMPILE_TIMEOUT_SECONDS=10

GEMINI_CRITIC_MODEL=gemini-3.1-flash-lite

# Used only when the primary Gemini model returns a rate-limit error.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_REVISION_MODEL=gemini-3.8-flash
EMAIL_DESIGN_REVISION_MAX_ATTEMPTS=1

# Resend delivery
# Keep the real API key only in backend/.env. Never expose it to Next.js.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Yo-kai Mail <onboarding@resend.dev>"
# Defaults to DEBUG locally. Keep false in production until auth/permissions exist.
RESEND_TEST_SEND_ENABLED=True

# Temporary generated-email asset cache
EMAIL_ASSET_CACHE_DIR=.cache/email_assets
EMAIL_ASSET_CACHE_TTL_SECONDS=21600
EMAIL_ASSET_MAX_IMAGE_BYTES=8388608
EMAIL_ASSET_MAX_INLINE_BYTES=20971520
EMAIL_ASSET_MAX_INLINE_COUNT=10

# Phase 2 campaign integration gateways.
# Adapters included in the integrated project. Blank values disable a gateway.
CAMPAIGN_ASSET_PROMOTION_GATEWAY=assets.campaign_gateway.CampaignAssetGateway
CAMPAIGN_DESIGN_REVISION_GATEWAY=email_visual_qa.campaign_gateway.CampaignDesignRevisionGateway
CAMPAIGN_AUDIENCE_GATEWAY=email_delivery.campaign_gateway.ContactsAudienceGateway
CAMPAIGN_DELIVERY_GATEWAY=email_delivery.campaign_gateway.ResendCampaignDeliveryGateway
RESEND_CAMPAIGN_SEND_ENABLED=False
RESEND_WEBHOOK_SECRET=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# For local preview only. Campaign deliveries require externally reachable HTTPS assets.
# Set a real CDN origin before enabling production campaign delivery.
ASSET_PUBLIC_BASE_URL=http://localhost:8000
